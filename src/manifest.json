{
  "manifest_version": 3,
  "name": "AnnoyTube: Consistent Arrow Keys for YouTube",
  "short_name": "AnnoyTube",
  "version": "1.0.0",
  "description": "YouTube's arrow keys always seek ±5 s and change the volume ±5 %, whatever has focus. Collects no data.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
