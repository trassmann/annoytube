{
  "name": "annoytube",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/content.ts src/manifest.json --bundle --outdir=dist --loader:.json=copy --target=chrome111",
    "dev": "pnpm build --watch",
    "check": "biome check && tsc && vitest run",
    "fix": "biome check --write",
    "test": "vitest"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
